# 复制为 .env 并填写本机 MySQL 配置。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_me
DB_NAME=langchain_lab

# 先升级迁移，再运行 python -m scripts.setup_agent_database 创建本地专属只读账号。
AGENT_DB_USER=shopmind_agent_ro
AGENT_DB_PASSWORD=
AGENT_QUERY_TIMEOUT_MS=2000

# Q01：llm 需要填写下方密钥；仅体验模拟功能时改为 mock，修改后重启后端。
CHAT_MODE=llm
# 标准兼容接口用 openai_compatible；DeepSeek 官方服务用 deepseek。
LLM_PROVIDER=deepseek
# 按所选服务的官方文档填写基础地址、模型名与密钥。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
